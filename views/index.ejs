<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>C-PESA</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .bg-fintech { background: linear-gradient(to bottom, #000000, #1a1a1a, #8B0000); min-height: 100vh; }
    </style>
</head>
<body class="bg-fintech text-white">
    <div class="max-w-md mx-auto p-6 flex flex-col min-h-screen">
        <header class="flex justify-between items-center mb-12">
            <div class="w-8"></div>
            <div class="text-center">
                <h1 class="text-zinc-400 text-sm font-semibold uppercase tracking-wider">Avax Price is</h1>
                <div id="price-container" class="mt-1">
                    <span class="text-3xl font-bold">Ksh: </span>
                    <span id="price-value" class="text-3xl font-bold">...</span>
                </div>
            </div>
            <button onclick="toggleSettings()" class="p-2 hover:bg-white/10 rounded-full transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.1a2 2 0 0 1-1-1.72v-.51a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
                    <circle cx="12" cy="12" r="3"/>
                </svg>
            </button>
        </header>

        <main class="flex-1 flex items-center justify-center">
            <div class="grid grid-cols-2 gap-4 w-full">
              
                <a href="/payment" class="aspect-square bg-white/5 border border-white/10 rounded-2xl flex flex-col items-center justify-center hover:bg-white/10 transition-all group">
                    <span class="text-xl font-bold group-hover:scale-110 transition-transform">Buy Avax</span>
                </a>
                <a href="/sell" class="aspect-square bg-white/5 border border-white/10 rounded-2xl flex flex-col items-center justify-center hover:bg-white/10 transition-all group">
                    <span class="text-xl font-bold group-hover:scale-110 transition-transform">Sell Avax</span>
                </a>
                <a href="/till" class="aspect-square bg-white/5 border border-white/10 rounded-2xl flex flex-col items-center justify-center hover:bg-white/10 transition-all group">
                    <span class="text-xl font-bold group-hover:scale-110 transition-transform">Buy Goods</span>
                </a>
                <a href="/send" class="aspect-square bg-white/5 border border-white/10 rounded-2xl flex flex-col items-center justify-center hover:bg-white/10 transition-all group">
                    <span class="text-xl font-bold group-hover:scale-110 transition-transform">Send Money</span>
                </a>
            </div>
        </main>

        <div id="settings-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden z-50 flex items-center justify-center p-6">
            <div class="bg-zinc-900 border border-white/10 rounded-3xl w-full max-w-sm p-6">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-xl font-bold">Settings</h2>
                    <button onclick="toggleSettings()" class="text-zinc-400 hover:text-white">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
                        </svg>
                    </button>
                </div>
                <form id="settings-form" class="space-y-4">
                    <div>
                        <label class="block text-sm text-zinc-400 mb-1">C-Chain Address</label>
                        <input type="text" name="cChainAddress" value="<%= user?.cChainAddress || '' %>" class="w-full bg-white/5 border border-white/10 rounded-xl p-3 focus:outline-none focus:border-red-500 transition-colors">
                    </div>
                    <div>
                        <label class="block text-sm text-zinc-400 mb-1">Phone Number</label>
                        <input type="text" name="phoneNumber" value="<%= user?.phoneNumber || '' %>" class="w-full bg-white/5 border border-white/10 rounded-xl p-3 focus:outline-none focus:border-red-500 transition-colors">
                    </div>
                    <button type="submit" class="w-full bg-red-600 hover:bg-red-500 text-white font-bold py-3 rounded-xl transition-colors mt-4">Save Changes</button>
                </form>
            </div>
        </div>
    </div>

    <script>
        async function updatePrice() {
            try {
                const res = await fetch('/api/price');
                const data = await res.json();
                document.getElementById('price-value').textContent = data.ksh.toLocaleString();
            } catch (e) {
                console.error('Price update failed');
            }
        }

        function toggleSettings() {
            const modal = document.getElementById('settings-modal');
            modal.classList.toggle('hidden');
        }

        document.getElementById('settings-form').onsubmit = async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData.entries());
            
            try {
                await fetch('/api/user', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                toggleSettings();
            } catch (e) {
                alert('Failed to save settings');
            }
        };

        setInterval(updatePrice, 30000);
        updatePrice();
    </script>
</body>
</html>